# =====================================================================
# seek-harness environment — copy to .env and edit
#   cp .env.example .env
# =====================================================================

# ── Web UI / proxy ───────────────────────────────────────────────────
# Publish bind for the proxy port. 127.0.0.1 = local machine only (safe).
# 0.0.0.0 = LAN accessible — then ALWAYS set Basic Auth below.
DSH_BIND=127.0.0.1

# Proxy (public) port and DSH (internal loopback) port — must differ.
PROXY_PORT=3080
DSH_PORT=3079

# Optional HTTP Basic Auth (HTTP + WebSocket). Auth is enabled ONLY when
# BOTH are set. Strongly recommended if DSH_BIND=0.0.0.0.
PROXY_USERNAME=
PROXY_PASSWORD=

# REQUIRED for LAN access. DSH's /api browser-trust fence only accepts
# loopback by default; add your LAN authority (host[:port]) so the UI's /api
# calls (models, plugins, settings) work from another machine.
# Example: DSH_TRUSTED_HOSTS=192.168.0.6:3080
DSH_TRUSTED_HOSTS=

# ── Docker engine access (pick ONE) ──────────────────────────────────
# Option A — Docker proxy over TCP (preferred; e.g. a socket proxy):
#DOCKER_HOST=tcp://docker-socket-proxy:2375
# Option B — host docker.sock via the compose.docker.yaml override:
#   docker compose -f compose.yaml -f compose.docker.yaml up -d
# and set the host docker group gid (check on HOST: stat -c %g /var/run/docker.sock)
DOCKER_GID=999

# ── Workspace ────────────────────────────────────────────────────────
# Absolute path the agent operates on (bind-mounted to /workspace).
DSH_WORKSPACE=./workspace

# ── Model credentials (runtime secrets — never bake into the image) ──
# Can also be configured in the Web UI settings page instead.
DEEPSEEK_API_KEY=
# Optional OpenAI-compatible / search overrides:
#DEEPSEEK_BASE_URL=
#DEEPSEEK_SEARCH_BASE_URL=

# ── Upstream runtime knobs (empty = upstream defaults) ───────────────
# Telemetry: 1 = hard-disabled locally (seek-harness default), empty = upstream
DSH_TELEMETRY_DISABLED=1
# Permission preset fallback: read-only | workspace-write | danger-full-access
DSH_PERMISSION_MODE=
# Tools mode: native | ptc | both
DSH_TOOLS_MODE=
# Extra flags for the DSH main process only (default: --expose-internals)
#DSH_NODE_FLAGS=--expose-internals
